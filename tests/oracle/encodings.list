cvt.d.w $f4,$f6
cvt.w.d $f0,$f2
cvt.w.d $f30,$f30
cvt.w.d $f4,$f6
# --- SPECIAL3, bit counts (Release 6: SPECIAL, rt = 0, sa = 1), jumps, CP0, zero-operand ---
clo $t0,$t1
clz $s0,$s1
clz $ra,$zero
clo $zero,$ra
seb $t0,$t1
seh $s0,$s1
wsbh $t0,$t1
wsbh $ra,$zero
jr $t0
jr $ra
jalr $t0
