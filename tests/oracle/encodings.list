sllv $t0,$t1,$t2
sllv $s7,$ra,$v1
sllv $zero,$gp,$k0
srlv $t0,$t1,$t2
srlv $s7,$ra,$v1
srlv $zero,$gp,$k0
srav $t0,$t1,$t2
srav $s7,$ra,$v1
srav $zero,$gp,$k0
teq $t0,$t1
teq $s7,$ra
tne $t0,$t1
tne $s7,$ra
tlt $t0,$t1
tlt $s7,$ra
tge $t0,$t1
tge $s7,$ra
tltu $t0,$t1
tltu $s7,$ra
