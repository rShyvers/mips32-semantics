# Instruction forms for scripts/oracle.py --encodings. One assembly line each.
# @T = label 8 bytes ahead (forward), @B = label 8 bytes behind (backward), both defined per record.
# Every mnemonic parsed from the tables in Semantics/Asm/*.lean must appear here (checked at run time). Release 6 forms only
# (llvm-mc -triple=mipsel -mcpu=mips32r6); the pre-Release 6 instructions Release 6 removed are assembler errors.
la $t0,@T
add $t0,$t1,$t2
add $s7,$ra,$v1
add $zero,$gp,$k0
addu $t0,$t1,$t2
addu $s7,$ra,$v1
addu $zero,$gp,$k0
sub $t0,$t1,$t2
sub $s7,$ra,$v1
sub $zero,$gp,$k0
subu $t0,$t1,$t2
subu $s7,$ra,$v1
subu $zero,$gp,$k0
and $t0,$t1,$t2
and $s7,$ra,$v1
and $zero,$gp,$k0
or $t0,$t1,$t2
or $s7,$ra,$v1
or $zero,$gp,$k0
xor $t0,$t1,$t2
xor $s7,$ra,$v1
xor $zero,$gp,$k0
nor $t0,$t1,$t2
nor $s7,$ra,$v1
nor $zero,$gp,$k0
slt $t0,$t1,$t2
slt $s7,$ra,$v1
slt $zero,$gp,$k0
sltu $t0,$t1,$t2
sltu $s7,$ra,$v1
sltu $zero,$gp,$k0
