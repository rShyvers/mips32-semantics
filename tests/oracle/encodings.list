andi $s0,$s1,65535
andi $ra,$zero,0x8000
ori $t0,$t1,0
ori $s0,$s1,65535
ori $ra,$zero,0x8000
xori $t0,$t1,0
xori $s0,$s1,65535
xori $ra,$zero,0x8000
lui $t0,0
lui $s0,65535
lui $ra,0x1234
aui $t0,$t1,0
aui $s0,$zero,0x8000
aui $ra,$sp,65535
aui $t2,$a0,0x1234
lw $t0,0($t1)
lw $s0,-4($sp)
