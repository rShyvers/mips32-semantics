add.d $f0,$f2,$f4
add.d $f30,$f28,$f26
sub.d $f0,$f2,$f4
sub.d $f30,$f28,$f26
mul.d $f0,$f2,$f4
mul.d $f30,$f28,$f26
div.d $f0,$f2,$f4
div.d $f30,$f28,$f26
mov.d $f0,$f2
