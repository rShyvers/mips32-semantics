# Instruction forms for scripts/oracle.py --encodings. One assembly line each.
# @T = label 8 bytes ahead (forward), @B = label 8 bytes behind (backward), both defined per record.
# Every mnemonic parsed from the tables in Semantics/Asm/*.lean must appear here (checked at run time). Release 6 forms only
# (llvm-mc -triple=mipsel -mcpu=mips32r6); the pre-Release 6 instructions Release 6 removed are assembler errors.
la $t0,@T
add $t0,$t1,$t2
add $s7,$ra,$v1
add $zero,$gp,$k0
addu $t0,$t1,$t2
addu $s7,$ra,$v1
addu $zero,$gp,$k0
